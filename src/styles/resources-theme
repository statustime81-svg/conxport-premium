
/* ConXport Resources Theme */

.cx-resources {
  --cx-navy: #043C50;
  --cx-orange: #D84312;
  --cx-light: #F1F7FA;
  --cx-muted: #657A80;
  color: var(--cx-navy);
  background: #fff;
  font-family: 'Manrope', system-ui, sans-serif;
}

.cx-resources h1,
.cx-resources h2,
.cx-resources h3,
.cx-resources .cx-serif {
  font-family: 'Cormorant Garamond', Georgia, serif;
  color: var(--cx-navy);
}

.cx-resources .cx-accent {
  color: var(--cx-orange);
  font-style: italic;
}

.cx-resources a {
  transition: color 0.25s ease;
}

.cx-resources a:hover {
  color: var(--cx-orange);
}
